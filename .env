# Example configuration of the Agromate server.
# Replace every value with yours and never commit real secrets
# (run `git update-index --skip-worktree .env` after editing it).

# SQLite database
DATABASE_URL="file:./dev.db"
# Secret used to sign the session tokens: use a long random string
JWT_SECRET=change-me

# MQTT broker (Mosquitto) and password of the api_server client
MQTT_URL=mqtt://mqtt-host:1883
MQTT_PASSWORD=change-me

# InfluxDB, where Telegraf stores the Agrosmart metrics
INFLUX_HOST=http://influxdb-host:8086
INFLUX_TOKEN=change-me
INFLUX_BUCKET=agromate
INFLUX_ORG=agromate

# Needed only for TURN support in webcam
TURN_URL=turn-host:3478
TURN_SECRET=change-me

# Maximum size of uploaded images: 2MB in bytes
MAX_IMAGE_SIZE=2097152

# Password reset email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=Agromate <no-reply@example.com>
RESET_PASSWORD_URL=http://server-host:3000/reset_password.html

# Push notifications (optional, need firebase-service-account.json)
# Minimum minutes between two identical alerts for the same Agrosmart
NOTIFICATION_COOLDOWN_MINUTES=360
# How long the notification worker caches the Agrosmart owner (ms)
AGROSMART_CACHE_TTL_MS=900000
# true = log the notifications instead of sending them
ALERT_DRY_RUN=false
